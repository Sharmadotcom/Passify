# Passify Environment Variables Template
# Copy this file to '.env' and fill in the values before running the application.

# Secret key used by Flask for signing session cookies
SECRET_KEY=your_flask_session_secret_key_here

# 32-byte Fernet key (base64-encoded) for database password encryption
# You can generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_encryption_key_here

# PostgreSQL connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/passify_db
